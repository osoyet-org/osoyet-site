---
import EventCard from './EventCard.astro';
import EventExpiry from './EventExpiry.astro';
import { getEvents } from '../lib/content';

const { upcoming } = await getEvents();
const next = upcoming.slice(0, 3);
---

{next.length > 0 && (
  <section id="events" class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <h2 class="text-3xl font-bold md:text-4xl">Upcoming events</h2>
    <p class="mt-3 max-w-2xl text-lg text-muted">Join us, volunteer, or support an event.</p>
    <ul class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {next.map((event) => (
        <li>
          <EventCard event={event} />
        </li>
      ))}
    </ul>
    <a href="/events" class="mt-8 inline-block font-semibold text-brand hover:underline">All events &rarr;</a>
    <EventExpiry />
  </section>
)}
