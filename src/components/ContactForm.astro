---
// Replace YOUR_FORM_ID with the ID from your Formspree form (formspree.io)
const formAction = 'https://formspree.io/f/mzedpozd';
const interests = ['Volunteer with us', 'Partner with us', 'Support a program', 'General question'];
---

<form action={formAction} method="POST" class="space-y-5">
  <div>
    <label for="name" class="block font-semibold">Full name</label>
    <input id="name" name="name" type="text" required autocomplete="name"
      class="mt-1 w-full rounded-lg border-2 border-brand-line bg-white px-4 py-3 focus:border-brand focus:outline-none" />
  </div>

  <div>
    <label for="email" class="block font-semibold">Email</label>
    <input id="email" name="email" type="email" required autocomplete="email"
      class="mt-1 w-full rounded-lg border-2 border-brand-line bg-white px-4 py-3 focus:border-brand focus:outline-none" />
  </div>

  <div>
    <label for="interest" class="block font-semibold">How would you like to get involved?</label>
    <select id="interest" name="interest"
      class="mt-1 w-full rounded-lg border-2 border-brand-line bg-white px-4 py-3 focus:border-brand focus:outline-none">
      {interests.map((item) => <option value={item}>{item}</option>)}
    </select>
  </div>

  <div>
    <label for="message" class="block font-semibold">Message</label>
    <textarea id="message" name="message" rows="5" required
      class="mt-1 w-full rounded-lg border-2 border-brand-line bg-white px-4 py-3 focus:border-brand focus:outline-none"></textarea>
  </div>

  <!-- Spam trap: real visitors never see or fill this -->
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  <button type="submit" class="rounded-full bg-brand px-8 py-3 font-semibold text-white hover:opacity-90">Send message</button>
    <p class="text-sm text-muted">We use your details only to reply to you. See our <a href="/privacy" class="underline hover:text-brand">privacy note</a>.</p>
</form>