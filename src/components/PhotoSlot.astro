---
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
}

const { src, alt = '', caption = 'Photo coming soon' } = Astro.props;
---

<figure class="overflow-hidden rounded-2xl border-2 border-brand-line bg-brand-soft">
  {src ? (
    <img src={src} alt={alt} loading="lazy" class="aspect-4/3 w-full object-cover" />
  ) : (
    <div class="flex aspect-4/3 w-full items-center justify-center p-4 text-center text-muted">
      <div>
        <svg class="mx-auto mb-2 stroke-brand" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <circle cx="9" cy="10" r="1.5"></circle>
          <path d="M21 16l-5-5-8 8"></path>
        </svg>
        <p>{caption}</p>
      </div>
    </div>
  )}
</figure>