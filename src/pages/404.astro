---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Osoyet Organization">
  <section class="mx-auto max-w-3xl px-5 py-20 text-center md:py-32">
    <h1 class="text-5xl font-bold text-brand md:text-6xl">Page not found</h1>
    <p class="mt-6 text-xl">Sorry, we could not find that page. It may have moved, or the link may be wrong.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/" class="rounded-full bg-brand px-7 py-3 font-semibold text-white hover:opacity-90">Go to the home page</a>
      <a href="/#contact" class="rounded-full border-2 border-brand px-7 py-3 font-semibold text-brand hover:bg-brand-soft">Contact us</a>
    </div>
  </section>
</Layout>