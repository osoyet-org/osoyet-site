---
import Layout from '../layouts/Layout.astro';

const principles = [
  { title: 'Led by local people', text: 'Community members help identify the challenges and develop practical solutions, so the work fits the people it serves.' },
  { title: 'Built on partnerships', text: 'We work with partners, community programs and local groups to reach further and last longer.' },
  { title: 'Mentorship and opportunity', text: 'Mentorship, sports, skills and environmental activities create opportunities for young people to grow and contribute.' },
  { title: 'Peace at the centre', text: 'Osoyet means peace. Everything we do aims to bring people together in harmony.' },
];
---

<Layout title="Our approach | Osoyet Organization">
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-24">
    <a href="/our-work" class="font-semibold text-brand hover:underline">&larr; Our work</a>
    <h1 class="mt-6 text-4xl font-bold text-brand md:text-5xl">Our approach</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">Meaningful change begins when communities come together, young people are empowered, and everyone has a chance to contribute.</p>
    <ul class="mt-10 grid gap-x-14 md:grid-cols-2">
      {principles.map((item) => (
        <li class="border-t-2 border-brand py-6">
          <h2 class="text-2xl font-semibold">{item.title}</h2>
          <p class="mt-2 text-muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </section>
</Layout>