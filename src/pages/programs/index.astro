---
import Layout from '../../layouts/Layout.astro';
import { programs } from '../../data/programs';
---

<Layout title="Programs | Osoyet Organization">
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-24">
    <a href="/our-work" class="font-semibold text-brand hover:underline">&larr; Our work</a>
    <h1 class="mt-6 text-4xl font-bold text-brand md:text-5xl">Programs</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">Six areas of work, each led with the people it serves.</p>
    <ul class="mt-10 grid gap-x-14 md:grid-cols-2">
      {programs.map((program) => (
        <li class="border-t-2 border-brand py-6">
          <h2 class="text-2xl font-semibold">{program.title}</h2>
          <p class="mt-2 text-muted">{program.summary}</p>
          <a href={`/programs/${program.slug}`} class="mt-3 inline-block font-semibold text-brand hover:underline">Learn more &rarr;</a>
        </li>
      ))}
    </ul>
  </section>
</Layout>