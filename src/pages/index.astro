---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { programs } from '../data/programs';
import { impact } from '../data/impact';
import { team } from '../data/team';
import { partners } from '../data/partners';
import { site, whatsappLink } from '../data/site';
---

<Layout>
  <!-- Hero -->
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 pb-16 pt-14 md:grid-cols-2 md:pb-24 md:pt-24">
    <div>
      <h1 class="text-5xl font-bold text-brand md:text-7xl">
        Osoyet<br /><span class="text-ink">means peace.</span>
      </h1>
      <p class="mt-6 max-w-xl text-xl">
        Building communities, empowering youth, creating a better future. We are a community-based organization working with local people to solve local challenges.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#programs" class="rounded-full bg-brand px-7 py-3 font-semibold text-white hover:opacity-90">See our work</a>
        <a href="#involved" class="rounded-full border-2 border-brand px-7 py-3 font-semibold text-brand hover:bg-brand-soft">Get involved</a>
      </div>
    </div>
    <div class="flex justify-center" aria-hidden="true">
      <svg viewBox="0 0 400 260" class="w-full max-w-md" fill="none" stroke-width="3">
        <circle class="stroke-brand" cx="200" cy="230" r="200" stroke-opacity="0.25"></circle>
        <circle class="stroke-brand" cx="200" cy="230" r="160" stroke-opacity="0.5"></circle>
        <circle class="stroke-brand" cx="200" cy="230" r="120" stroke-opacity="0.75"></circle>
        <path class="fill-brand" d="M120 230a80 80 0 0 1 160 0z" stroke="none"></path>
        <path class="stroke-brand" d="M0 230h400" stroke-width="4"></path>
      </svg>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="bg-brand-soft">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 md:grid-cols-5 md:py-20">
      <h2 class="text-3xl font-bold md:col-span-2 md:text-4xl">Communities solving their own challenges</h2>
      <div class="max-w-2xl space-y-4 text-lg md:col-span-3">
        <p>Osoyet Organization was established in 2023 to promote peace, empower communities and improve the well-being of young people and society.</p>
        <p>Local people help identify the challenges and shape the solutions. Through partnerships, mentorship, sports, environmental activities and health work, we create opportunities and build stronger, healthier and more united communities.</p>
        <p>Our name, Osoyet, means "peace". It describes the communities we want to help build, where people live, work and grow together in harmony.</p>
        <div class="pt-4">
          <PhotoSlot src="/images/community-group.jpg" alt="Osoyet team and community members together" caption="Osoyet's community work" />
        </div>
      </div>
    </div>
  </section>

  <!-- Impact -->
  {impact.length > 0 && (
    <section id="impact" class="mx-auto max-w-6xl px-5 py-16 md:py-20">
      <h2 class="text-3xl font-bold md:text-4xl">Our impact</h2>
      <dl class="mt-10 grid grid-cols-2 gap-8 md:grid-cols-4">
        {impact.map((item) => (
          <div class="flex flex-col-reverse border-t-2 border-brand pt-4">
            <dt class="text-muted">{item.label}</dt>
            <dd class="font-display text-4xl font-bold text-brand">{item.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  <!-- Our work -->
  <section id="programs" class="mx-auto max-w-6xl px-5 py-16 md:py-24">
    <h2 class="text-3xl font-bold md:text-4xl">Our work</h2>
    <p class="mt-3 max-w-2xl text-lg text-muted">Six areas of work, each led with the people it serves.</p>
    <ul class="mt-10 grid gap-x-14 md:grid-cols-2">
      {programs.map((program) => (
        <li class="border-t-2 border-brand py-6">
          <h3 class="text-2xl font-semibold">{program.title}</h3>
          <p class="mt-2 text-muted">{program.summary}</p>
          <a href={`/programs/${program.slug}`} class="mt-3 inline-block font-semibold text-brand hover:underline">Learn more &rarr;</a>
        </li>
      ))}
    </ul>
    <div class="mt-4 flex flex-wrap gap-4">
      <a href="/programs" class="rounded-full bg-brand px-7 py-3 font-semibold text-white hover:opacity-90">All programs</a>
      <a href="/where-we-work" class="rounded-full border-2 border-brand px-7 py-3 font-semibold text-brand hover:bg-brand-soft">Where we work</a>
      <a href="/our-approach" class="rounded-full border-2 border-brand px-7 py-3 font-semibold text-brand hover:bg-brand-soft">Our approach</a>
    </div>
  </section>

  <!-- Team -->
  {team.length > 0 && (
    <section id="team" class="bg-brand-soft">
      <div class="mx-auto max-w-6xl px-5 py-16 md:py-20">
        <h2 class="text-3xl font-bold md:text-4xl">Our team</h2>
        <p class="mt-3 max-w-2xl text-lg text-muted">The people who lead and carry out Osoyet's work.</p>
        <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {team.map((member) => (
            <li>
              {member.photo ? (
                <img src={member.photo} alt={member.name} loading="lazy" class="aspect-square w-full rounded-2xl object-cover" />
              ) : (
                <div class="flex aspect-square w-full items-center justify-center rounded-2xl bg-white font-display text-5xl font-bold text-brand" aria-hidden="true">{member.name.charAt(0)}</div>
              )}
              <h3 class="mt-4 text-xl font-semibold">{member.name}</h3>
              <p class={member.role.includes('CEO') ? 'font-bold text-brand' : 'text-muted'}>{member.role}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Support -->
  <section id="support" class="mx-auto grid max-w-6xl gap-10 px-5 py-16 md:grid-cols-2 md:py-24">
    <div>
      <h2 class="text-3xl font-bold md:text-4xl">Support our work</h2>
      <p class="mt-4 max-w-lg text-lg">Your contribution helps us run programs in health, the environment, youth mentorship, sports, peace and education. Every amount makes a difference.</p>
    </div>
    <div class="rounded-2xl border-2 border-brand p-8">
      <p class="text-xl font-semibold">{site.mpesa.label}</p>
      <dl class="mt-4 space-y-3 text-lg">
        <div><dt class="text-muted">Number</dt><dd class="font-semibold">{site.mpesa.paybill}</dd></div>
        <div><dt class="text-muted">Account name</dt><dd class="font-semibold">{site.mpesa.account}</dd></div>
      </dl>
    </div>
  </section>

  <!-- Get involved -->
  <section id="involved" class="bg-brand-soft">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-2 md:py-20">
      <div>
        <h2 class="text-3xl font-bold md:text-4xl">Change begins when communities come together</h2>
        <p class="mt-4 max-w-lg text-lg">Volunteer your time, partner with us or support a program. Everyone has something to contribute.</p>
      </div>
      <div class="flex flex-wrap gap-4 md:justify-end">
        <a href="#contact" class="rounded-full bg-brand px-7 py-3 font-semibold text-white hover:opacity-90">Volunteer</a>
        <a href="#contact" class="rounded-full border-2 border-brand bg-white px-7 py-3 font-semibold text-brand hover:bg-brand-soft">Become a partner</a>
        <a href="#support" class="rounded-full border-2 border-brand bg-white px-7 py-3 font-semibold text-brand hover:bg-brand-soft">Support our work</a>
      </div>
    </div>
  </section>

    <!-- Partners -->
  <section id="partners" class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <h2 class="text-3xl font-bold md:text-4xl">Partner with us</h2>
    <p class="mt-3 max-w-2xl text-lg">Osoyet is open to working with organizations, schools, businesses and individuals who share our goals. Together we can reach more communities.</p>
    {partners.length > 0 && (
      <div class="mt-8">
      </div>
    )}
    <a href="#contact" class="mt-8 inline-block rounded-full bg-brand px-7 py-3 font-semibold text-white hover:opacity-90">Become a partner</a>
  </section>

  <!-- Contact -->
  <section id="contact" class="mx-auto grid max-w-6xl gap-10 px-5 py-16 md:grid-cols-2 md:py-24">
    <div>
      <h2 class="text-3xl font-bold md:text-4xl">Talk to us</h2>
      <p class="mt-3 max-w-md text-lg text-muted">Tell us how you would like to help or work together.</p>
      <dl class="mt-8 space-y-4 text-lg">
        <div><dt class="font-semibold">Email</dt><dd class="text-muted">{site.email}</dd></div>
        <div><dt class="font-semibold">Phone</dt><dd class="text-muted">{site.phone}</dd></div>
        <div><dt class="font-semibold">Location</dt><dd class="text-muted">{site.address}</dd></div>
      </dl>
      <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-3 rounded-full bg-brand px-7 py-3 font-semibold text-white hover:opacity-90">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
        </svg>
        Chat with us on WhatsApp
      </a>
    </div>
    <ContactForm />
  </section>
</Layout>