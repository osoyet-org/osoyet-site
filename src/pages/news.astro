---
import Layout from '../layouts/Layout.astro';
import { getNews, formatDate } from '../lib/content';

// 1. Define the structure of a post so TypeScript understands it
interface Post {
  id: string;
  data: {
    title: string;
    date: string | Date;
    image?: string;
    summary?: string;
  };
}

// 2. Cast the response to your Post array type
const posts = (await getNews()) as Post[];
---

<Layout title="News | Osoyet Organization" description="News and updates from Osoyet Organization.">
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-24">
    <h1 class="text-4xl font-bold md:text-5xl">News</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">Updates from our work in Olulunga and Narok.</p>

    {posts.length === 0 ? (
      <p class="mt-10 text-lg text-muted">Updates are coming soon.</p>
    ) : (
      <ul class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <li class="flex h-full flex-col overflow-hidden rounded-2xl border-2 border-brand-line bg-white">
            {post.data.image && <img src={post.data.image} alt="" loading="lazy" class="aspect-ratio-[16/9] w-full object-cover" />}
            <div class="flex flex-1 flex-col p-6">
             <p class="font-semibold text-brand">{formatDate(new Date(post.data.date))}</p>
              <h2 class="mt-2 text-2xl font-semibold">{post.data.title}</h2>
              {post.data.summary && <p class="mt-3 text-muted">{post.data.summary}</p>}
              <a href={`/news/${post.id}`} class="mt-auto pt-5 font-semibold text-brand hover:underline">Read more &rarr;</a>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
