---
import Layout from '../layouts/Layout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';

interface Photo {
  caption: string;
  src?: string;
}

const photos: Photo[] = [
  { caption: 'Sanitary pad distribution at a school event', src: '/images/school-event-1.jpg' },
  { caption: 'Students with sanitary pads at a school event', src: '/images/school-event-2.jpg' },
  { caption: 'Tree planting with students', src: '/images/tree-planting-school.jpg' },
  { caption: 'Planting a seedling', src: '/images/tree-planting-seedling.jpg' },
  { caption: 'Team planting trees', src: '/images/tree-planting-team.jpg' },
  { caption: 'Our team at Olmekenyu Health Centre', src: '/images/health-centre-team.jpg' },
  { caption: 'Community members together', src: '/images/community-group.jpg' },
];
---

<Layout title="Gallery | Osoyet Organization">
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-24">
    <h1 class="text-4xl font-bold text-brand md:text-5xl">Gallery</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">Moments from our work with communities.</p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {photos.map((photo) => (
        <div>
          <PhotoSlot src={photo.src} alt={photo.caption} caption={photo.caption} />
          <p class="mt-2 text-muted">{photo.caption}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>